{
  "name": "camlittle-com",
  "account_id": "b12fc7e0594361391a2e8fab40e3d278",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  // A route rather than a custom domain: paths not served here fall through to
  // the origin behind the proxied DNS record via fetch(request).
  "routes": [{ "pattern": "camlittle.com/*", "zone_name": "camlittle.com" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/profile.jpg",
      "/typescript.novaextension",
      "/secret-sharing",
      "/secret-sharing/*",
      "/go-template-validation",
      "/strava-tile-proxy",
      "/strava-tile-proxy/*",
      "/.well-known/acme-challenge/*"
    ]
  }
}
